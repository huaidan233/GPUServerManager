GSM_ENV=development
GSM_API_HOST=0.0.0.0
GSM_API_PORT=8000
GSM_API_URL=http://127.0.0.1:8000
GSM_WEB_API_URL=http://api:8000
GSM_ALLOWED_ORIGINS=https://gsm.example.invalid
GSM_TRUSTED_PROXY_SECRET=
GSM_EDGE_PROXY_SECRET=
GSM_WEB_JSON_MAX_BYTES=1048576
GSM_MFA_ENCRYPTION_KEY=
GSM_SESSION_HASH_KEY=
GSM_SETTINGS_ENCRYPTION_KEY=
GSM_DATABASE_URL=sqlite:////var/lib/gpu-server-manager/control.sqlite
GSM_TELEMETRY_DATABASE_URL=sqlite:////var/lib/gpu-server-manager/telemetry.sqlite
GSM_ANALYTICS_DATABASE_URL=sqlite:////var/lib/gpu-server-manager/analytics.sqlite
GSM_TELEMETRY_RETENTION_HOURS=72
GSM_GOVERNANCE_INTERVAL_SECONDS=60
GSM_CONFIRMATION_EXECUTION_TIMEOUT_SECONDS=900
GSM_GPU_STALE_AFTER_SECONDS=180
GSM_SERVER_AGENT_URL=http://server-agent:8000
# Production installer generates this file; blank keeps development fixtures.
GSM_SERVER_INVENTORY_PATH=
# First-install overrides (blank uses detected defaults; refresh existing inventory explicitly).
GSM_RESERVED_CPUS=
GSM_RESERVED_MEMORY_GB=
GSM_AGENT_MODE=mock
GSM_AGENT_CONTAINER_RUNTIME=runc
GSM_AGENT_ALLOWED_MOUNT_ROOTS=/data:/scratch
# Test deployments use their own roots and container ownership namespace.
GSM_DEPLOYMENT_ID=production
GSM_DATA_ROOT=/data
GSM_SCRATCH_ROOT=/scratch
# Blank preserves the production port binding behavior; tests use 127.0.0.1.
GSM_AGENT_SSH_BIND_ADDRESS=
GSM_AGENT_TRUSTED_SSH_IMAGE_IDS=
GSM_AGENT_HEALTH_PATHS=/,/data,/scratch
GSM_AGENT_RECEIPT_DB_PATH=/var/lib/gpu-server-manager/server-agent/operation-receipts.sqlite3
GSM_SSH_CA_PRIVATE_KEY_PATH=/etc/gpu-server-manager/ssh/member_ca
GSM_SSH_TRUSTED_CA_PUBLIC_KEY=
GSM_HEALTH_INTERVAL_SECONDS=60
GSM_GPU_TEMPERATURE_WARNING_C=80
GSM_GPU_TEMPERATURE_CRITICAL_C=88
GSM_DIAGNOSTIC_MAX_LOG_BYTES=65536
GSM_DIAGNOSTIC_MODEL_ENDPOINT=
GSM_DIAGNOSTIC_MODEL_API_KEY=
GSM_DIAGNOSTIC_MODEL_NAME=
GSM_BACKUP_BACKEND=local
GSM_BACKUP_DIR=/var/lib/gpu-server-manager/backups
# Backups retain the newest 10 verified archives, plus active recovery protection.
GSM_BACKUP_HOUR_UTC=18
GSM_BACKUP_ENCRYPTION_KEY=
GSM_PRINT_BLOB_BACKEND=local
GSM_PRINT_BLOB_DIR=/var/lib/gpu-server-manager/print-jobs
GSM_PRINT_FILE_ENCRYPTION_KEY=
GSM_PRINT_MAX_FILE_BYTES=104857600
GSM_PRINT_MULTIPART_OVERHEAD_BYTES=1048576
GSM_PRINT_NORMALIZE_TIMEOUT_SECONDS=30
GSM_PRINT_NORMALIZE_MEMORY_MB=512
GSM_PRINT_NORMALIZE_CPU_SECONDS=20
GSM_PRINT_MAX_PAGES=1000
GSM_PRINT_MAX_COPIES=20
GSM_PRINT_DRAFT_RETENTION_MINUTES=60
GSM_PRINT_FILE_RETENTION_HOURS=24
GSM_PRINT_METADATA_RETENTION_DAYS=90
GSM_PRINT_AGENT_STALE_SECONDS=90
GSM_PRINT_LEASE_SECONDS=60
GSM_AGENT_SHARED_TOKEN=
GSM_TEST_AGENT_TOKEN=
GSM_WECHAT_SERVICE_TOKEN=
GSM_WECHAT_INTERNAL_TOKEN=
GSM_WECHAT_OUTBOUND_URL=http://wechat-agent:8000/wechat-agent/outbound
# webhook keeps the existing bridge contract; ilink enables native personal WeChat.
GSM_WECHAT_CHANNEL=webhook
GSM_WECHAT_ILINK_STATE_DIR=/var/lib/gpu-server-manager/wechat-ilink
GSM_WECHAT_ILINK_INBOUND_URL=http://wechat-agent:8000/wechat-agent/inbound
GSM_WECHAT_CHANNEL_WEBHOOK_URL=
GSM_WECHAT_INBOUND_SECRET=
GSM_WECHAT_INBOUND_MAX_BODY_BYTES=1048576
GSM_WECHAT_CONVERSATION_TTL_SECONDS=1800
GSM_WECHAT_MAX_CONVERSATIONS=1000
GSM_WECHAT_MEDIA_BASE_URL=
GSM_WECHAT_MEDIA_TOKEN=
GSM_WECHAT_PRINT_UPLOAD_TIMEOUT_SECONDS=150
GSM_DOCKER_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://registry.docker-cn.com
GSM_ENABLE_TEST_ENDPOINTS=true

# Optional integration secrets.
# Put real values in .env for local development. Ubuntu keeps Agent provider
# bootstrap values in the API-only /etc/gpu-server-manager/agent-settings.env.
# Never commit real API keys.
OPENAI_API_KEY=
OPENAI_BACKUP_API_KEY=
OPENAI_ENDPOINT=
OPENAI_MODEL=gpt-5.5
GSM_WECHAT_APP_ID=
GSM_WECHAT_APP_SECRET=
GSM_WECHAT_TOKEN=
GSM_WECHAT_ENCODING_AES_KEY=
# Container applications must use a different HTTPS origin from the Manager.
# Example: https://apps.example.edu (never add this to GSM_ALLOWED_ORIGINS).
GSM_APP_PUBLIC_ORIGIN=
GSM_APP_NETWORK_POOL=172.30.0.0/16

# Private storage: initialize a mounted data disk before enabling these paths.
# See docs/deployment-guide.md; do not invent a block-device number.
GSM_PERSONAL_DATA_ROOT=
GSM_PERSONAL_DATA_DEVICE=
GSM_SNAPSHOT_ROOT=
GSM_RUNTIME_STORAGE_PATH=
GSM_RUNTIME_STORAGE_DEVICE=
GSM_DATA_UID=10000
GSM_DATA_GID=10000
GSM_DATA_RESERVE_BYTES=21474836480
GSM_SFTPGO_URL=
GSM_SFTPGO_API_KEY=
GSM_SFTPGO_USERS_ROOT=/srv/gsm-users
GSM_PUBLIC_SSH_HOST=
GSM_DATA_SFTP_BIND_ADDRESS=127.0.0.1
GSM_DATA_SFTP_PORT=2222
# Optional public GitHub release checks. No repository means updates are disabled.
# Set the actual owner/repository only after publishing the sanitized public source.
GSM_UPDATE_REPOSITORY=
# stable excludes prereleases; choose prerelease explicitly to receive release candidates.
GSM_UPDATE_CHANNEL=stable

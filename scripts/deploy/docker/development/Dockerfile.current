ARG BASE_IMAGE=gsm/python-base:3.12.14-20260923
FROM ${BASE_IMAGE}
COPY requirements-current.txt /opt/gsm/requirements-current.txt
ARG GSM_WHEEL_INDEX
RUN if [ -n "${GSM_WHEEL_INDEX}" ]; then python -m pip install --no-cache-dir --no-index --no-deps --find-links="${GSM_WHEEL_INDEX}" -r /opt/gsm/requirements-current.txt; fi \
    && python -m pip install --no-cache-dir -r /opt/gsm/requirements-current.txt \
    && python -m pip check \
    && python -m pip freeze > /opt/gsm/installed-requirements.txt
COPY workbench-check.py /usr/local/bin/gsm-workbench-check
RUN chmod 0755 /usr/local/bin/gsm-workbench-check
LABEL gsm.environment="python" gsm.framework="python-workbench" gsm.applications="jupyter,tensorboard"
